# ───────────────────────────────────────────────────────────────────────────
# Zero-Knowledge Vault - environment
# Copy this file to `.env.local` and fill in the values. NEVER commit .env.local.
# All three are PUBLIC values (safe to expose in the browser bundle). Your
# secrets are never derivable from them - the vault is protected by your master
# password, which never leaves the browser.
# ───────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Project Settings > API > anon public.
# This is the ONLY Supabase key the app uses. Do NOT put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The single fixed account email for this personal vault. Used ONLY as the
# Supabase login identifier and as the auth-secret salt. Use a real address you
# control. A normal Gmail works (no custom domain needed). Example: you@gmail.com
NEXT_PUBLIC_VAULT_EMAIL=

# ── DEV ONLY (optional) ──────────────────────────────────────────────────────
# Direct Postgres connection for `npm run db:reset` (the anon key cannot run DDL).
# Supabase Dashboard > Project Settings > Database > Connection string >
# "Session pooler" (URI, port 5432). It CONTAINS YOUR DB PASSWORD - keep secret.
# Not needed to run the app; only for resetting the schema during development.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
