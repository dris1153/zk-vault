# ───────────────────────────────────────────────────────────────────────────
# Zero-Knowledge Vault - environment
# Copy this file to `.env.local` and fill in the values. NEVER commit .env.local.
# Both are PUBLIC values (safe to expose in the browser bundle). Your secrets are
# never derivable from them - the vault is protected by your master password,
# which never leaves the browser.
#
# NOTE: the vault email is NOT an env var. You enter it on the lock screen at first
# signup/unlock; it is remembered in this browser and prefilled afterwards.
# ───────────────────────────────────────────────────────────────────────────

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Project Settings > API > anon public.
# This is the ONLY Supabase key the app uses. Do NOT put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── DEV ONLY (optional) ──────────────────────────────────────────────────────
# Direct Postgres connection for `npm run db:reset` (the anon key cannot run DDL).
# Supabase Dashboard > Project Settings > Database > Connection string >
# "Session pooler" (URI, port 5432). It CONTAINS YOUR DB PASSWORD - keep secret.
# Not needed to run the app; only for resetting the schema during development.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
